.venv/
__pycache__/
.DS_Store
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
_site/
# Hub data: fetched by `task data` and `task data-bvd`, and by each
# workflow before use. Tests read the frozen copy in tests/fixtures/data/.
# Only our own records are committed: what we submitted to the hub and
# the unsubmitted candidates, which nothing can fetch again.
data/*
!data/our-submissions/
!data/candidate-forecasts.csv.gz
# Backtest forecasts and other run output: re-created by `task backtest`.
output/
# Derived results: made by the Pages build (`task results` locally) from
# the code, the data and the fit store. Only these records are committed.
results/*
!results/development-log.csv
!results/ladder.csv
!results/model-choice.yml
# Docs figures and generated snippets: built at docs build time.
docs/figures/*.svg
docs/generated/
# Pages of submitted rounds: copied (frozen) or built from the
# submission-ledger branch at each docs build.
docs/submission/rounds/
tests/results/
# The Getting started notebook and its figures: built at docs build time
# from docs/getting-started.py (`task getting-started`).
docs/getting-started.ipynb
docs/assets/getting-started/
# The rendered paper: copied in from paper/ at docs build time
# (`task paper:render`).
docs/paper/
# mkdocs-jupyter execution cache.
.cache/
docs/figures/*.json
# Written by `fit-store load` from the fit-store branch.
results/fit-store.json
results/delay-summary.csv

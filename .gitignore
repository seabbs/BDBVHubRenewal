.venv/
__pycache__/
.DS_Store
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
_site/
# Raw hub downloads: re-created by `task data`.
data/raw/
# Backtest forecasts and other run output: re-created by `task backtest`.
output/
# Docs figures and generated snippets: built at docs build time.
docs/figures/*.svg
docs/generated/
# Pages of submitted rounds: copied (frozen) or built from the
# submission-ledger branch at each docs build.
docs/submission/rounds/
tests/results/
# The Getting started notebook and its figures: built at docs build time
# from docs/getting-started.py (`task getting-started`).
docs/getting-started.ipynb
docs/assets/getting-started/
# mkdocs-jupyter execution cache.
.cache/
docs/figures/*.json
# Derived results: made by the Pages build (`task results` locally) from
# the code, the data and the fit store. Only these records are committed.
results/*
!results/development-log.csv
!results/ladder.csv
!results/model-choice.yml

# Round r3 of the Chronos-2 fine-tune (scripts/finetune_driver.sh): the
# factorial grid of scripts/finetune_simulate.R, 10 draws per simulation,
# 16 blocks sampled per simulation, checkpoints at doublings until a
# doubling cuts held-out loss by under 1%. Set REMOTE= to run every seed
# on this machine.
GRID=r3
SIM_DIR=output/finetune/sims-r3grid
TRAIN_FIRST=10001
TRAIN_LAST=10400
HELD_FIRST=9901
HELD_LAST=9910
# The paper's held-out synthetic set (balanced blocks 1670 and 1671 and
# spares), never trained on.
EXTRA_SEEDS="$(seq -s ' ' 8016 8025)"
LOCAL_FIRST=10391
LOCAL_LAST=10400
LOCAL_SLOTS=4
LOCAL_MAX_LOAD=12
LOCAL_SLOTS_TRAINING=1
LOCAL_MIN_FREE_MEM_GB=12
REMOTE=archie
REMOTE_DIR=code/seabbs/BDBVHubRenewal/.worktrees/fm-sim-r2
SIM_REMOTE=output/finetune/sims-r3grid
# Peak RSS of r3 batches (10 draws) on archie, in GB: 7.0, 7.1, 8.8
# (10012), 11.8 (10272), 12.8 (10084), 13.8 (10118); median about 9.8.
# The largest four aborted under a 10 GB cap. The cap is the largest
# plus 15%, 16 GB, so archie, with 62 GB, runs (62 - 16) / 16 = 2.
REMOTE_RAM_GB=62
REMOTE_SLOTS=2
REMOTE_MEM_KB=16777216
# A batch R aborts under that cap runs again alone under 20 GB.
REMOTE_RETRY_MEM_KB=20971520
REMOTE_MIN_FREE_GB=6
REMOTE_MIN_FREE_MEM_GB=10
REMOTE_MAX_LOAD=15
REMOTE_RETRY=600
REMOTE_GRACE=1800
FIRST_CHUNK_SEEDS=24
OUT=output/finetune/ckpt-r3
OUTBREAKS=64000
# The GPU limits training, so simulation stops 4,000 outbreaks ahead of
# the trainer and starts again under 2,000.
LEAD_MAX=4000
LEAD_RESUME=2000
PREFIXES="1000 2000 4000 8000 16000 32000 64000"
STOP_FROM=8000
MIN_GAIN=0.01
BLOCKS_PER_SIMULATION=16
MEMORY_GB=36
MPS_HIGH_WATERMARK=0.85
PUBLISH=1

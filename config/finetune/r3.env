# Round r3 of the Chronos-2 fine-tune (scripts/finetune_driver.sh): the
# factorial grid of scripts/finetune_simulate.R, 10 draws per simulation,
# 16 blocks sampled per simulation, checkpoints at doublings until a
# doubling cuts held-out loss by under 1%. Set REMOTE= to run every seed
# on this machine.
GRID=r3
SIM_DIR=output/finetune/sims-r3grid
TRAIN_FIRST=10001
TRAIN_LAST=10400
HELD_FIRST=9901
HELD_LAST=9910
LOCAL_FIRST=10391
LOCAL_LAST=10400
LOCAL_SLOTS=4
LOCAL_SLOTS_TRAINING=1
LOCAL_MIN_FREE_MEM_GB=12
REMOTE=archie
REMOTE_DIR=code/seabbs/BDBVHubRenewal/.worktrees/fm-sim-r2
SIM_REMOTE=output/finetune/sims-r3grid
REMOTE_SLOTS=12
REMOTE_MEM_KB=10485760
REMOTE_MIN_FREE_GB=6
REMOTE_MIN_FREE_MEM_GB=10
REMOTE_MAX_LOAD=15
REMOTE_RETRY=600
REMOTE_GRACE=1800
FIRST_CHUNK_SEEDS=24
OUT=output/finetune/ckpt-r3
OUTBREAKS=64000
PREFIXES="1000 2000 4000 8000 16000 32000 64000"
STOP_FROM=8000
MIN_GAIN=0.01
BLOCKS_PER_SIMULATION=16
MEMORY_GB=36
MPS_HIGH_WATERMARK=0.85
PUBLISH=1

# Round r4 of the Chronos-2 fine-tune (scripts/finetune_driver.sh), not
# launched. Chronos-2's own fine-tuning recipe (LoRA defaults, its loss,
# learning rate 1e-5 falling linearly to zero over LR_STEPS) on a broad
# grid aimed at the task: ragged weekly, daily and 3-day blocks whose
# targets are the nowcast steps and the forecast steps beyond the origin,
# from sparse and dense outbreaks with Rt per place, mid-outbreak seeding
# and broad D. Checkpoints are chosen on real validation blocks from the
# hub's delay table before the paper's first scored week
# (scripts/finetune_real_validation.py, written first to REAL_VALIDATION).
GRID=r4
SIM_DIR=output/finetune/sims-r4grid
TRAIN_FIRST=10001
TRAIN_LAST=10400
HELD_FIRST=9901
HELD_LAST=9910
LOCAL_FIRST=10391
LOCAL_LAST=10400
LOCAL_SLOTS=4
LOCAL_MAX_LOAD=12
LOCAL_SLOTS_TRAINING=1
LOCAL_MIN_FREE_MEM_GB=12
REMOTE=archie
REMOTE_DIR=code/seabbs/BDBVHubRenewal/.worktrees/fm-sim-r2
SIM_REMOTE=output/finetune/sims-r4grid
# Peak RSS of r3 batches (10 draws) on archie, in GB: 7.0, 7.1, 8.8
# (10012), 11.8 (10272), 12.8 (10084), 13.8 (10118); median about 9.8.
# The largest four aborted under a 10 GB cap. The cap is the largest
# plus 15%, 16 GB, so archie, with 62 GB, runs (62 - 16) / 16 = 2.
REMOTE_RAM_GB=62
REMOTE_SLOTS=2
REMOTE_MEM_KB=16777216
# A batch R aborts under that cap runs again alone under 20 GB.
REMOTE_RETRY_MEM_KB=20971520
REMOTE_MIN_FREE_GB=6
REMOTE_MIN_FREE_MEM_GB=10
REMOTE_MAX_LOAD=15
REMOTE_RETRY=600
REMOTE_GRACE=1800
FIRST_CHUNK_SEEDS=24
OUT=output/finetune/ckpt-r4
OUTBREAKS=1000
# The GPU limits training, so simulation stops 4,000 outbreaks ahead of
# the trainer and starts again under 2,000.
LEAD_MAX=4000
LEAD_RESUME=2000
PREFIXES="500 1000"
STOP_FROM=1000
MIN_GAIN=0.01
BLOCKS_PER_SIMULATION=16
MEMORY_GB=36
MPS_HIGH_WATERMARK=0.85
PUBLISH=1
LEARNING_RATE=1e-5
LR_STEPS=2000
REAL_VALIDATION=output/finetune/real-validation.pkl
SOURCES="weekly daily 3day"
